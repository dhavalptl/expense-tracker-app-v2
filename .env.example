# Required for preview / Nitro / production Node.
# Generate something long and random for real deploys.
SESSION_SECRET=dev-local-session-secret-change-me

# Required in production. Use a path on a persistent writable volume.
# Local default is fine for preview/dev:
DATABASE_PATH=data/app.sqlite
# Production example:
# DATABASE_PATH=/var/lib/expense-tracker/app.sqlite

# Optional directory for `npm run db:backup`
# DATABASE_BACKUP_DIR=backups
